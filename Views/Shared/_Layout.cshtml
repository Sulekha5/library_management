<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryManagement</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- ✅ NAYA: Chart.js add kiya -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var currentRole = Context.Session.GetString("Role") ?? "";
        }
        <nav class="navbar navbar-expand-sm">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2" style="color:#c084fc;"></i>LibraryManagement
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-fill me-1"></i>Home
                            </a>
                        </li>

                        <!-- Admin Dropdown — sirf Admin ko dikhao -->
                        @if (currentRole == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-badge-fill me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu" style="background:#3b0090; border:none;
                                    border-radius:10px; min-width:190px;">
                                    <li>
                                        <a class="dropdown-item" href="/Home/Manager"
                                               style="color:#e0d0ff; padding:10px 16px;">
                                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Home/AvailableBooks"
                                               style="color:#e0d0ff; padding:10px 16px;">
                                            <i class="bi bi-book me-2"></i>Available Books
                                        </a>
                                    </li>
                                    <li>
                                        <!-- Issued Books — sirf Admin -->
                                        <a class="dropdown-item" href="/Home/IssuedBooks"
                                               style="color:#e0d0ff; padding:10px 16px;">
                                            <i class="bi bi-journal-check me-2"></i>Issued Books
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Home/Return"
                                               style="color:#e0d0ff; padding:10px 16px;">
                                            <i class="bi bi-arrow-return-left me-2"></i>Return Book
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- Student ke liye Available Books link alag se -->
                        @if (currentRole == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Home/AvailableBooks">
                                    <i class="bi bi-book me-1"></i>Available Books
                                </a>
                            </li>
                        }

                        <!-- Privacy — sabko dikhao -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i>Privacy
                            </a>
                        </li>

                        <!-- My History — sirf Student -->
                        @if (currentRole == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Home/StudentHistory">
                                    <i class="bi bi-journal-bookmark-fill me-1"></i>My History
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Profile">
                                    <i class="bi bi-person-circle me-1"></i>My Profile
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Logout — right side, sirf logged in users ko -->
                    @if (currentRole == "Admin" || currentRole == "Student")
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a href="/Auth/Logout" class="btn btn-logout me-2">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer mt-5">
        <div class="container py-3 text-center">
            <i class="bi bi-book-half me-1" style="color:#5510a1;"></i>
            &copy; 2026 - LibraryManagement -
            <a asp-controller="Home" asp-action="Privacy" style="color:#5510a1;">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>