@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5">
    <div class="card p-4 shadow" style="max-width:460px; margin:auto; background: linear-gradient(135deg, #1e3c72, #2a5298); border-radius:16px;">
        
        <div class="text-center mb-4">
            <i class="bi bi-key-fill" style="font-size:50px; color:#b454f0;"></i>
            <h2 class="mt-2" style="color:white !important;">Reset Password</h2>
            <p style="color:#ccc; font-size:14px;">Enter OTP sent to your email</p>
        </div>

        <form method="post" action="/Auth/ResetPassword">
            <div class="mb-3">
                <label style="color:#ddd !important;">OTP Code</label>
                <input type="text" name="otp" placeholder="Enter OTP" class="form-control" required />
            </div>
            <div class="mb-3">
                <label style="color:#ddd !important;">New Password</label>
                <input type="password" name="newPassword" placeholder="Enter new password" class="form-control" required />
            </div>

            <div class="d-grid mt-3">
                <button class="btn custom-btn">Reset Password</button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert mt-3" style="background:#ff4d4d22; border:1px solid #ff4d4d; color:#ff4d4d; border-radius:8px; padding:10px;">
                    ⚠️ @ViewBag.Error
                </div>
            }
        </form>
    </div>
</div>