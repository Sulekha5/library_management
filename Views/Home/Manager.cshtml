@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="page-header">
    <div>
        <i class="bi bi-speedometer2 me-2" style="color:#5510a1; font-size:26px;"></i>
        <span class="page-header-title">Library Manager Dashboard</span>
    </div>
</div>

<!-- Stat Cards -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="stat-card">
            <i class="bi bi-book-fill" style="font-size:32px;"></i>
            <h6 class="mt-2">Total Books</h6>
            <h2 id="totalBooks">--</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <i class="bi bi-journal-check" style="font-size:32px;"></i>
            <h6 class="mt-2">Issued Books</h6>
            <h2 id="issuedBooks">--</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card highlight">
            <i class="bi bi-hourglass-split" style="font-size:32px;"></i>
            <h6 class="mt-2">Pending Requests</h6>
            <h2 id="pendingRequests">--</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <i class="bi bi-people-fill" style="font-size:32px;"></i>
            <h6 class="mt-2">Students</h6>
            <h2 id="totalStudents">--</h2>
        </div>
    </div>
</div>

<!-- ✅ NAYA: Charts Section — yahan add kiya -->
<div class="row mb-4 g-3">
    <div class="col-md-6">
        <div class="section-card" style="height:320px;">
            <div class="section-card-title">
                <i class="bi bi-pie-chart me-2"></i>Books Overview
            </div>
            <canvas id="booksChart" style="max-height:230px;"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="section-card" style="height:320px;">
            <div class="section-card-title">
                <i class="bi bi-bar-chart me-2"></i>Library Stats
            </div>
            <canvas id="statsChart" style="max-height:230px;"></canvas>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="mb-4 d-flex gap-3 flex-wrap">
    <a href="/Home/AvailableBooks" class="btn custom-btn">
        <i class="bi bi-book me-1"></i>Available Books
    </a>
    <a href="/Home/IssuedBooks" class="btn custom-btn">
        <i class="bi bi-journal-check me-1"></i>Issued Books
    </a>
    <a href="/Home/Return" class="btn custom-btn">
        <i class="bi bi-arrow-return-left me-1"></i>Return Book
    </a>
</div>

<!-- Book Inventory -->
<div class="section-card">
    <div class="section-card-title">
        <i class="bi bi-table me-2"></i>Book Inventory
    </div>

    <div class="table-responsive">
        <table class="table table-bordered" id="bookTable">
            <thead>
                <tr>
                    <th>Book ID</th>
                    <th>Book Name</th>
                    <th>Author</th>
                    <th>Quantity</th>
                    <th style="width:60px;">Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr class="first-row">
                    <td><input type="number" class="form-control" placeholder="Book ID" /></td>
                    <td><input type="text" class="form-control" placeholder="Book name" /></td>
                    <td><input type="text" class="form-control" placeholder="Author" /></td>
                    <td><input type="number" class="form-control" placeholder="Qty" /></td>
                    <td>
                        <button disabled style="
                            width:34px; height:34px; border-radius:50%;
                            background:#ccc !important; border:none;
                            color:white; font-size:22px; font-weight:bold;
                            cursor:not-allowed; line-height:1;
                            display:flex; align-items:center; justify-content:center; margin:auto;">
                            −
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2 mt-3 align-items-center">
        <button id="addRow" style="
            width:40px; height:40px; border-radius:50%;
            background:#5510a1 !important; border:none;
            color:white; font-size:26px; font-weight:bold;
            cursor:pointer; line-height:1;
            display:flex; align-items:center; justify-content:center;
            transition:0.3s; box-shadow:0 4px 12px rgba(85,16,161,0.3);">
            +
        </button>
        <button class="btn custom-btn" id="submitData">
            <i class="bi bi-floppy me-1"></i>Submit
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/manager.js"></script>

    <!-- ✅ NAYA: Chart script — yahan add kiya -->
    <script>
        fetch('/Home/GetDashboardData')
            .then(r => r.json())
            .then(data => {
                const total     = data.totalBooks      || 0;
                const issued    = data.issuedBooks     || 0;
                const pending   = data.pendingRequests || 0;
                const students  = data.totalStudents   || 0;
                const available = Math.max(total - issued, 0);

                // 🍩 Pie Chart
                new Chart(document.getElementById("booksChart"), {
                    type: "doughnut",
                    data: {
                        labels: ["Available", "Issued", "Pending"],
                        datasets: [{
                            data: [available, issued, pending],
                            backgroundColor: ["#16a34a", "#5510a1", "#d97706"],
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: { color: "#1e1e2f", font: { size: 13 } }
                            }
                        }
                    }
                });

                // 📊 Bar Chart
                new Chart(document.getElementById("statsChart"), {
                    type: "bar",
                    data: {
                        labels: ["Total Books", "Issued", "Pending", "Students"],
                        datasets: [{
                            label: "Count",
                            data: [total, issued, pending, students],
                            backgroundColor: [
                                "rgba(85,16,161,0.8)",
                                "rgba(124,58,237,0.8)",
                                "rgba(217,119,6,0.8)",
                                "rgba(22,163,74,0.8)"
                            ],
                            borderRadius: 8,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { color: "#1e1e2f", stepSize: 1 },
                                grid:  { color: "#f0f0f0" }
                            },
                            x: {
                                ticks: { color: "#1e1e2f" },
                                grid:  { display: false }
                            }
                        }
                    }
                });
            });
    </script>
}