@{
    ViewData["Title"] = "Available Books";
    var role = Context.Session.GetString("Role") ?? "";
    var isAdmin = role == "Admin";
}

<div class="page-header">
    <div>
        <i class="bi bi-book me-2" style="color:#5510a1; font-size:26px;"></i>
        <span class="page-header-title">Available Books</span>
    </div>
    <a href="@(isAdmin ? "/Home/Manager" : "/Home/Index")"
           class="btn custom-btn" style="font-size:14px; padding:8px 18px;">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<!-- Search Bar -->
<div class="section-card mb-3" style="padding:16px;">
    <div class="input-group">
        <span class="input-group-text" style="background:#5510a1; border:none;">
            <i class="bi bi-search" style="color:white;"></i>
        </span>
        <input type="text" id="searchInput" class="form-control"
               placeholder="Search by Book Name or Book ID..."
               style="border-left:none; font-size:15px;" />
    </div>
</div>

<div class="section-card">
    <div class="table-responsive">
        <table class="table table-bordered" id="booksTable">
            <thead>
                <tr>
                    <th>Book ID</th>
                    <th>Name</th>
                    <th>Author</th>
                    <th>Quantity</th>
                    @if (isAdmin)
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody id="booksBody">
                <tr>
                    <td colspan="@(isAdmin ? 5 : 4)"
                        style="text-align:center; padding:20px; color:#888;">
                        Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Modal — sirf admin ke liye render ho -->
@if (isAdmin)
{
    <div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%;
        height:100%; background:rgba(0,0,0,0.5); z-index:9999;">
        <div style="background:white; width:420px; margin:80px auto; padding:30px;
            border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
            <div class="text-center mb-3">
                <i class="bi bi-pencil-square" style="font-size:36px; color:#5510a1;"></i>
                <h4 class="mt-2" style="color:#1e1e2f !important;">Edit Book</h4>
            </div>
            <input type="hidden" id="editId" />
            <div class="mb-3">
                <label>Book Name</label>
                <input type="text" id="editName" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Author</label>
                <input type="text" id="editAuthor" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Quantity</label>
                <input type="number" id="editQuantity" class="form-control" />
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn custom-btn flex-grow-1" id="updateBook"
                        style="font-size:14px; padding:9px;">
                    <i class="bi bi-floppy me-1"></i>Update
                </button>
                <button class="btn flex-grow-1" onclick="closeModal()"
                        style="font-size:14px; padding:9px; background:#6b7280 !important;">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ✅ Server se role pass karo JS mein
        const isAdmin = @Json.Serialize(isAdmin);
        let allBooks  = [];

        fetch('/Home/GetRecords')
            .then(r => r.json())
            .then(data => {
                allBooks = data.books || [];
                renderBooks(allBooks);
            })
            .catch(() => {
                document.getElementById("booksBody").innerHTML =
                    `<tr><td colspan="${isAdmin ? 5 : 4}"
                      style="color:red;text-align:center;">Failed to load</td></tr>`;
            });

        function renderBooks(data) {
            const tbody = document.getElementById("booksBody");
            const cols  = isAdmin ? 5 : 4;
            tbody.innerHTML = "";

            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${cols}"
                    style="color:#888;text-align:center;padding:20px;">
                    <i class="bi bi-inbox" style="font-size:28px;display:block;
                    margin-bottom:6px;"></i>No books found</td></tr>`;
                return;
            }

            data.forEach(b => {
                const id     = b.bookId  ?? b.BookId;
                const name   = b.name    ?? b.Name   ?? "";
                const author = b.author  ?? b.Author ?? "";
                const qty    = b.quantity ?? b.Quantity ?? 0;
                const qtyStyle = qty <= 5 ? 'color:#dc2626;font-weight:bold;' : '';

                // ✅ Action column sirf admin ke liye
                const actionCol = isAdmin ? `
                    <td>
                        <button class="btn" style="font-size:13px;padding:4px 10px;margin-right:4px;"
                            onclick="openEdit(${id},'${name.replace(/'/g,"\\'")}',
                                    '${author.replace(/'/g,"\\'")}',${qty})">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn"
                            style="font-size:13px;padding:4px 10px;background:#dc2626 !important;"
                            onclick="deleteBook(${id})">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>` : "";

                tbody.innerHTML += `
                <tr>
                    <td>${id}</td>
                    <td>${name}</td>
                    <td>${author}</td>
                    <td style="${qtyStyle}">${qty}</td>
                    ${actionCol}
                </tr>`;
            });
        }

        // Search
        document.getElementById("searchInput").addEventListener("input", function () {
            const q = this.value.toLowerCase().trim();
            if (!q) { renderBooks(allBooks); return; }
            renderBooks(allBooks.filter(b =>
                (b.name   ?? b.Name   ?? "").toLowerCase().includes(q) ||
                String(b.bookId ?? b.BookId ?? "").includes(q)
            ));
        });

        // Edit/Delete — sirf admin call kar sakta hai
        function openEdit(id, name, author, qty) {
            if (!isAdmin) return;
            document.getElementById("editId").value       = id;
            document.getElementById("editName").value     = name;
            document.getElementById("editAuthor").value   = author;
            document.getElementById("editQuantity").value = qty;
            document.getElementById("editModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("editModal").style.display = "none";
        }

        if (isAdmin) {
            document.getElementById("updateBook").addEventListener("click", function () {
                const payload = {
                    bookId:   parseInt(document.getElementById("editId").value),
                    name:     document.getElementById("editName").value,
                    author:   document.getElementById("editAuthor").value,
                    quantity: parseInt(document.getElementById("editQuantity").value)
                };
                fetch('/Home/UpdateBook', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(r => r.json())
                .then(res => { alert(res.message); closeModal(); location.reload(); });
            });
        }

              function deleteBook(id) {
            if (!isAdmin) return;
    
            // ✅ Purana: if (!confirm("Delete this book?")) return;
            // ✅ Naya: styled confirm dialog
            showConfirm("This book will be permanently deleted!", function() {
                fetch(`/Home/DeleteBook/${id}`, { method: 'DELETE' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showToast("Book deleted successfully!", "success");
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast(res.message || "Delete failed!", "error");
                    }
                })
                .catch(() => showToast("Something went wrong!", "error"));
            });
        }
    </script>
}