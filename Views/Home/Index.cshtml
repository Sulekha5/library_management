@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center" style="margin-top:60px;">
    <i class="bi bi-book-half" style="font-size:80px; color:#5510a1;"></i>
    <h1 class="mt-3" style="color:#1e1e2f !important; font-size:2.4rem; font-weight:700;">
        Welcome to Library Management
    </h1>
    <p style="color:#555; font-size:17px; margin-top:8px;">
        Manage books, students, and records all in one place.
    </p>

    <div class="row justify-content-center mt-5 g-4">
        <div class="col-md-3">
            <div class="section-card text-center p-4 h-100">
                <i class="bi bi-journal-plus" style="font-size:40px; color:#5510a1;"></i>
                <h5 class="mt-3" style="color:#1e1e2f !important;">Issue Books</h5>
                <p style="color:#666; font-size:13px;">Issue books to students quickly</p>
                <a href="/Home/Issue" class="btn custom-btn mt-2" style="font-size:14px; padding:8px 24px;">Go</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="section-card text-center p-4 h-100">
                <i class="bi bi-clipboard2-data" style="font-size:40px; color:#5510a1;"></i>
                <h5 class="mt-3" style="color:#1e1e2f !important;">Available Books</h5>
                <p style="color:#666; font-size:13px;">View all available books</p>
                <a href="/Home/AvailableBooks" class="btn custom-btn mt-2" style="font-size:14px; padding:8px 24px;">Go</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="section-card text-center p-4 h-100">
                <i class="bi bi-arrow-return-left" style="font-size:40px; color:#5510a1;"></i>
                <h5 class="mt-3" style="color:#1e1e2f !important;">Return Book</h5>
                <p style="color:#666; font-size:13px;">Process book returns & fines</p>
                <a href="/Home/Return" class="btn custom-btn mt-2" style="font-size:14px; padding:8px 24px;">Go</a>
            </div>
        </div>
    </div>
</div>