@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "My Profile";
    var student = ViewBag.Student;
    string name = student?.Name ?? "Student";
    string email = student?.Email ?? "";
    char initial = name.Length > 0 ? char.ToUpper(name[0]) : 'S';
}

<div class="row g-4">

    <!-- Profile Card -->
    <div class="col-md-4">
        <div class="section-card text-center" style="padding:30px;">

            <!-- Avatar -->
            <div style="width:90px; height:90px; border-radius:50%;
                background:linear-gradient(135deg,#5510a1,#7c3aed);
                display:flex; align-items:center; justify-content:center;
                margin:0 auto 16px; font-size:36px; color:white; font-weight:700;
                box-shadow:0 4px 16px rgba(85,16,161,0.3);">
                @initial
            </div>

            <h4 style="color:#1e1e2f !important; font-weight:700;">@name</h4>
            <p style="color:#888; font-size:14px; margin-bottom:20px;">
                <i class="bi bi-envelope me-1"></i>@email
            </p>

            <div style="background:#f5f3ff; border-radius:10px;
                padding:10px; margin-bottom:8px; text-align:left;">
                <small style="color:#888;">Role</small>
                <div style="color:#5510a1; font-weight:600;">
                    <i class="bi bi-mortarboard me-1"></i>Student
                </div>
            </div>
        </div>

        <!-- Stats mini cards -->
        <div class="row g-2 mt-1">
            <div class="col-6">
                <div style="background:linear-gradient(135deg,#5510a1,#7c3aed);
                    border-radius:12px; padding:16px; text-align:center;
                    color:white;">
                    <div style="font-size:24px; font-weight:700;">
                        @ViewBag.TotalBooks
                    </div>
                    <div style="font-size:12px; opacity:0.8;">Total Issued</div>
                </div>
            </div>
            <div class="col-6">
                <div style="background:linear-gradient(135deg,#d97706,#f59e0b);
                    border-radius:12px; padding:16px; text-align:center;
                    color:white;">
                    <div style="font-size:24px; font-weight:700;">
                        @ViewBag.Pending
                    </div>
                    <div style="font-size:12px; opacity:0.8;">Pending</div>
                </div>
            </div>
            <div class="col-6">
                <div style="background:linear-gradient(135deg,#16a34a,#22c55e);
                    border-radius:12px; padding:16px; text-align:center;
                    color:white;">
                    <div style="font-size:24px; font-weight:700;">
                        @ViewBag.Approved
                    </div>
                    <div style="font-size:12px; opacity:0.8;">Approved</div>
                </div>
            </div>
            <div class="col-6">
                <div style="background:linear-gradient(135deg,#dc2626,#ef4444);
                    border-radius:12px; padding:16px; text-align:center;
                    color:white;">
                    <div style="font-size:24px; font-weight:700;">
                        ₹@ViewBag.TotalFine
                    </div>
                    <div style="font-size:12px; opacity:0.8;">Total Fine</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Book History Table -->
    <div class="col-md-8">
        <div class="section-card">
            <div class="section-card-title">
                <i class="bi bi-clock-history me-2"></i>Book History
            </div>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Issue Date</th>
                            <th>Return Date</th>
                            <th>Fine</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusStr = item.Status?.ToString() ?? "Pending";
                                int fine = (int)(item.Fine ?? 0);

                                <tr>
                                    <td>@item.Book</td>
                                    <td>
                                        @(((DateTime)item.IssueDate)
                                          .ToString("dd MMM yyyy"))
                                    </td>
                                    <td>
                                        @(((DateTime)item.ReturnDate)
                                          .ToString("dd MMM yyyy"))
                                    </td>
                                    <td style="@(fine > 0 ? "color:#dc2626;font-weight:bold;" : "")">
                                        @(fine > 0 ? $"₹{fine}" : "-")
                                    </td>
                                    <td>
                                        @if (statusStr == "Approved")
                                        {
                                            <span style="background:#dcfce7; color:#16a34a;
                                                padding:3px 10px; border-radius:20px;
                                                border:1px solid #16a34a; font-size:12px;">
                                                ✅ Approved
                                            </span>
                                        }
                                        else if (statusStr == "Denied")
                                        {
                                            <span style="background:#fee2e2; color:#dc2626;
                                                padding:3px 10px; border-radius:20px;
                                                border:1px solid #dc2626; font-size:12px;">
                                                ❌ Denied
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background:#fef9c3; color:#b45309;
                                                padding:3px 10px; border-radius:20px;
                                                border:1px solid #d97706; font-size:12px;">
                                                ⏳ Pending
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;
                                    padding:30px; color:#888;">
                                    <i class="bi bi-inbox"
                                       style="font-size:28px; display:block;
                                    margin-bottom:8px;"></i>
                                    No books issued yet
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>