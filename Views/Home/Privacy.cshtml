@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card p-4 shadow" style="background:linear-gradient(135deg,#1e3c72,#2a5298); border-radius:16px; max-width:700px; margin:auto;">
    <div class="text-center mb-4">
        <i class="bi bi-shield-check" style="font-size:50px; color:#b454f0;"></i>
        <h1 class="mt-2" style="color:white !important;">Privacy Policy</h1>
    </div>
    <p style="color:#ccc; line-height:1.8;">
        This Library Management System collects minimal personal information such as your name, email address,
        and book borrowing history solely for the purpose of managing library operations.
    </p>
    <p style="color:#ccc; line-height:1.8;">
        Your data is stored securely and is never shared with third parties. You may contact the librarian
        to request deletion of your account and associated records at any time.
    </p>
    <p style="color:#ccc; line-height:1.8;">
        By using this system, you agree to the collection and use of information as described above.
    </p>
</div>