@{
    ViewData["Title"] = "Records";
}

<!-- Page header: title left, back button right -->
<div class="page-header">
    <div>
        <i class="bi bi-clipboard2-data me-2" style="color:#5510a1; font-size:26px;"></i>
        <span class="page-header-title">Library Records</span>
    </div>
    <a href="/Home/Manager" class="btn custom-btn" style="font-size:14px; padding:8px 18px;">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<!-- Available Books -->
<div class="section-card">
    <div class="section-card-title">
        <i class="bi bi-book me-2"></i>Available Books
    </div>
    <div class="table-responsive">
        <table class="table table-bordered" id="booksTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>BookId</th>
                    <th>Author</th>
                    <th>Quantity</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Issued Books -->
<div class="section-card">
    <div class="section-card-title">
        <i class="bi bi-journal-check me-2"></i>Issued Books
    </div>
    <div class="table-responsive">
        <table class="table table-bordered" id="issuedTable">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Issue Date</th>
                    <th>Return Date</th>
                    <th>Fine</th>
                    <th>Action</th>
                    <th>Permission</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,0.5); z-index:9999;">
    <div style="background:white; width:420px; margin:80px auto; padding:30px;
        border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.2);">

        <div class="text-center mb-3">
            <i class="bi bi-pencil-square" style="font-size:36px; color:#5510a1;"></i>
            <h4 class="mt-2" style="color:#1e1e2f !important;">Edit Book</h4>
        </div>

        <input type="hidden" id="editId" />

        <div class="mb-3">
            <label>Book Name</label>
            <input type="text" id="editName" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Author</label>
            <input type="text" id="editAuthor" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Quantity</label>
            <input type="number" id="editQuantity" class="form-control" />
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn custom-btn flex-grow-1" id="updateBook"
                    style="font-size:14px; padding:9px;">
                <i class="bi bi-floppy me-1"></i>Update
            </button>
            <button class="btn flex-grow-1" onclick="closeModal()"
                    style="font-size:14px; padding:9px; background:#6b7280 !important;">
                <i class="bi bi-x-circle me-1"></i>Cancel
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/records.js"></script>
}