@{
    ViewData["Title"] = "Issued Books";
}

<div class="page-header">
    <div>
        <i class="bi bi-journal-check me-2" style="color:#5510a1; font-size:26px;"></i>
        <span class="page-header-title">Issued Books</span>
    </div>
    <a href="/Home/Manager" class="btn custom-btn" style="font-size:14px; padding:8px 18px;">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<!-- Search Bar -->
<div class="section-card mb-3" style="padding:16px;">
    <div class="input-group">
        <span class="input-group-text" style="background:#5510a1; border:none;">
            <i class="bi bi-search" style="color:white;"></i>
        </span>
        <input type="text" id="searchInput" class="form-control"
               placeholder="Search by Student Name or Book Name..."
               style="border-left:none; font-size:15px;" />
    </div>
</div>

<div class="section-card">
    <div class="table-responsive">
        <table class="table table-bordered" id="issuedTable">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Issue Date</th>
                    <th>Return Date</th>
                    <th>Fine</th>
                    <th>Reminder</th>
                    <th>Permission</th>
                </tr>
            </thead>
            <tbody id="issuedBody">
                <tr>
                    <td colspan="7" style="text-align:center; padding:20px; color:#888;">
                        Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let allIssued = [];

        // ✅ Correct endpoint: same GetRecords, issued array use karo
        fetch('/Home/GetRecords')
            .then(r => r.json())
            .then(data => {
                allIssued = data.issued || [];
                renderIssued(allIssued);
            })
            .catch(err => {
                document.getElementById("issuedBody").innerHTML =
                    `<tr><td colspan="7" style="color:red; text-align:center;">Failed to load data</td></tr>`;
            });

        function renderIssued(data) {
            const tbody = document.getElementById("issuedBody");
            tbody.innerHTML = "";
            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="color:#888; text-align:center; padding:20px;">
                    <i class="bi bi-inbox" style="font-size:28px; display:block; margin-bottom:6px;"></i>
                    No issued books found</td></tr>`;
                return;
            }
            data.forEach(b => {
                const issueDate  = b.issueDate  ? new Date(b.issueDate).toLocaleDateString('en-IN')  : "-";
                const returnDate = b.returnDate ? new Date(b.returnDate).toLocaleDateString('en-IN') : "-";
                const fine       = b.fine ?? 0;
                const status     = b.status ?? "Pending";
                const id         = b.id;

                // Permission badge + buttons
                let permissionHtml = "";
                if (status === "Approved") {
                    permissionHtml = `<span style="background:#dcfce7; color:#16a34a; padding:4px 12px;
                        border-radius:20px; border:1px solid #16a34a; font-size:13px;">✅ Approved</span>`;
                } else if (status === "Denied") {
                    permissionHtml = `<span style="background:#fee2e2; color:#dc2626; padding:4px 12px;
                        border-radius:20px; border:1px solid #dc2626; font-size:13px;">❌ Denied</span>`;
                } else {
                    permissionHtml = `
                        <button class="btn" style="font-size:12px; padding:3px 8px; margin-right:3px; background:#16a34a !important;"
                            onclick="approveRequest(${id})">
                            ✅ Approve
                        </button>
                        <button class="btn" style="font-size:12px; padding:3px 8px; background:#dc2626 !important;"
                            onclick="denyRequest(${id})">
                            ❌ Deny
                        </button>`;
                }

                // Fine color
                const fineStyle = fine > 0 ? 'color:#dc2626; font-weight:bold;' : '';

                tbody.innerHTML += `
                <tr>
                    <td>${b.student}</td>
                    <td>${b.book}</td>
                    <td>${issueDate}</td>
                    <td>${returnDate}</td>
                    <td style="${fineStyle}">₹${fine}</td>
                    <td>
                        <button class="btn" style="font-size:12px; padding:4px 10px;"
                            onclick="sendReminder('${b.student}','${b.book}','${b.returnDate}')">
                            <i class="bi bi-bell"></i> Reminder
                        </button>
                    </td>
                    <td>${permissionHtml}</td>
                </tr>`;
            });
        }

        // Search
        document.getElementById("searchInput").addEventListener("input", function () {
            const q = this.value.toLowerCase().trim();
            if (!q) { renderIssued(allIssued); return; }
            const filtered = allIssued.filter(b =>
                (b.student ?? "").toLowerCase().includes(q) ||
                (b.book    ?? "").toLowerCase().includes(q)
            );
            renderIssued(filtered);
        });

        // Approve
               function approveRequest(id) {
            showConfirm("Approve this book request?", function() {
                fetch(`/Home/ApproveRequest?id=${id}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    showToast(res.message, "success");
                    setTimeout(() => location.reload(), 1500);
                })
                .catch(() => showToast("Something went wrong!", "error"));
            });
        }

        function denyRequest(id) {
            showConfirm("Deny this book request?", function() {
                fetch(`/Home/DenyRequest?id=${id}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    showToast(res.message, "warning");
                    setTimeout(() => location.reload(), 1500);
                })
                .catch(() => showToast("Something went wrong!", "error"));
            });
        }

        function sendReminder(student, book, returnDate) {
            showToast("Sending reminder...", "info");
            fetch('/Home/SendReminderEmail', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `student=${encodeURIComponent(student)}&book=${encodeURIComponent(book)}&returnDate=${encodeURIComponent(returnDate)}`
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showToast("Reminder sent successfully! 📧", "success");
                } else {
                    showToast("Failed: " + res.message, "error");
                }
            })
            .catch(() => showToast("Email sending failed!", "error"));
        }
    </script>
}